PW_KEY=your_pirate_weather_api_key
LAT=29.xxxx
LON=-95.xxxx
NTFY_URL=https://ntfy.securefiber.net/rain
NTFY_TOKEN=tk_your_ntfy_token
# DEBUG=1   (extra log detail)
# DEBUG=2   (extra detail + one test notification per container start)

# Alert thresholds (optional; defaults shown)
# LOOKAHEAD_MIN=30    minutes ahead to look (1-60)
# MIN_PROB=0.5        chance of rain needed, 0-1
# MIN_INTENSITY=0.5   rain rate needed, mm/h (0.5 light, 2.5 moderate, 7.5 heavy)
# RAINING_NOW=0.1     current rate (mm/h) that counts as "already raining"
# REPEAT_MIN=0        re-send every N minutes while rain is still predicted (0 = once)
# SCOPE_HOSTS=        comma-separated scope IPs/hostnames (host or host:port, default 4700);
#                     if set, alerts only fire while at least one scope is reachable
